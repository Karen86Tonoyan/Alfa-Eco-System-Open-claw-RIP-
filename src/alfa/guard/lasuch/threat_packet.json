{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alfa.local/schemas/lasuch/threat_packet.json",
  "title": "ThreatPacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "threat_id",
    "pattern_type",
    "severity",
    "confidence",
    "matched_text",
    "normalized_text",
    "source_type",
    "language_hint",
    "span_start",
    "span_end",
    "quarantine_state",
    "evidence_refs",
    "source_hash",
    "observed_at"
  ],
  "properties": {
    "threat_id": {
      "type": "string",
      "format": "uuid"
    },
    "pattern_type": {
      "type": "string",
      "minLength": 3
    },
    "severity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "matched_text": {
      "type": "string",
      "minLength": 1
    },
    "normalized_text": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "enum": ["prompt", "code", "template", "message", "file"]
    },
    "language_hint": {
      "type": ["string", "null"]
    },
    "span_start": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "span_end": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "quarantine_state": {
      "type": "string",
      "enum": ["ISOLATED", "ANALYZED", "CONTAINED"]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
